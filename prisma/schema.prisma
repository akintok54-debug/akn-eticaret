generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           String  @id @default(cuid())
  erpProductId String? @unique

  sku         String  @unique
  barcode     String? @unique
  name        String
  brand       String
  category    String
  description String  @default("")

  purchasePrice Float @default(0)
  retailPrice   Float
  dealerPrice   Float
  vatRate       Float @default(20)

  stock         Int @default(0)
  criticalStock Int @default(0)

  image  String?
  additionalImages String[] @default([])
  active Boolean @default(true)

  showcases String[] @default([])
  showcaseOrder Json @default("{}")
  shippingStatus String @default("Sistem")
  shippingWeight Float @default(0)
  extraDetail String @default("")
  seoTitle String @default("")
  seoDescription String @default("")

  lastErpSyncAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderItems      OrderItem[]
  variants        ProductVariant[]
  compatibilities ProductCompatibility[]
  attributes      ProductAttribute[]

  @@index([name])
  @@index([brand])
  @@index([category])
}

model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  erpVariantId String? @unique
  sku          String  @unique
  barcode      String? @unique

  name  String?
  color String?
  size  String?

  purchasePrice Float?
  retailPrice   Float?
  dealerPrice   Float?

  stock  Int     @default(0)
  image  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([color])
  @@index([size])
}

model ProductCompatibility {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  make  String
  model String

  yearFrom Int?
  yearTo   Int?

  engine String?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, make, model, yearFrom, yearTo])
  @@index([productId])
  @@index([make])
  @@index([model])
}

model Customer {
  id            String  @id @default(cuid())
  erpCustomerId String? @unique

  fullName String
  phone    String  @unique
  email    String?

  type         String @default("retail")
  dealerStatus String @default("none")
  discountRate Float  @default(0)

  companyName String?
  taxOffice   String?
  taxNumber   String?

  active Boolean @default(true)

  lastErpSyncAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account   CustomerAccount?
  addresses Address[]
  orders    Order[]
  groupId   String?
  group     CustomerGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  shoppingCarts      ShoppingCart[]
  dealerApplications DealerApplication[]
  supportTickets     SupportTicket[]
  accountPayments    AccountPayment[]

  @@index([fullName])
  @@index([type])
  @@index([dealerStatus])
}

model Address {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title    String @default("Adres")
  fullName String
  phone    String

  city     String
  district String
  address  String

  invoiceType String  @default("individual")
  companyName String?
  taxOffice   String?
  taxNumber   String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model Order {
  id             String  @id @default(cuid())
  guestSessionId String?
  checkoutKey    String? @unique
  erpOrderId     String? @unique

  orderNumber String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String
  customerEmail String?

  city            String
  district        String
  deliveryAddress String

  invoiceType String  @default("individual")
  companyName String?
  taxOffice   String?
  taxNumber   String?

  couponCode        String?
  shippingCompany   String?
  trackingNumber    String?
  trackingUrl       String?
  paymentStatus     String    @default("pending")
  paidAt            DateTime?
  returnRequestedAt DateTime?

  shippingMethod String
  paymentMethod  String

  status       String    @default("Yeni")
  returnReason String?
  returnedAt   DateTime?
  returnNote   String?

  subtotal      Float
  shippingTotal Float @default(0)
  discountTotal Float @default(0)
  total         Float

  lastErpSyncAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items OrderItem[]

  @@index([customerId])
  @@index([guestSessionId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  sku         String
  barcode     String?

  unitPrice Float
  quantity  Int
  vatRate   Float
  lineTotal Float

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name  String
  value String
  unit  String?
  note  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name, value])
  @@index([productId])
  @@index([name])
}

model ShoppingCart {
  id        String @id @default(cuid())
  sessionId String @unique

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String?
  customerPhone String?
  customerEmail String?

  status          String  @default("Aktif")
  checkoutStarted Boolean @default(false)

  itemCount Int   @default(0)
  total     Float @default(0)

  // Odeme asamasina ne zaman gecildi
  checkoutStartedAt DateTime?

  // Sepet ne zaman terk edildi
  abandonedAt DateTime?

  // Terk edilen sepet daha sonra geri kazanildiysa
  recoveredAt DateTime?

  // Gercek siparise donustugu zaman
  completedAt DateTime?

  // Olusan siparis bilgileri
  orderId     String?
  orderNumber String?

  // Hatirlatma takibi
  reminderSentAt DateTime?
  reminderCount  Int       @default(0)

  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items     ShoppingCartItem[]
  reminders CartReminder[]

  @@index([status])
  @@index([lastActivityAt])
  @@index([customerId])
  @@index([checkoutStarted])
  @@index([completedAt])
  @@index([orderId])
}

model ShoppingCartItem {
  id String @id @default(cuid())

  cartId String
  cart   ShoppingCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId   String
  productName String
  image       String?
  price       Float
  quantity    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model CustomerGroup {
  id String @id @default(cuid())

  name        String  @unique
  code        String  @unique
  description String?

  type String @default("retail")

  discountRate Float @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]

  @@index([type])
  @@index([active])
}

model DealerApplication {
  id String @id @default(cuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  fullName String
  phone    String
  email    String?

  companyName String

  taxOffice String?
  taxNumber String?

  city     String?
  district String?
  address  String?

  note String?

  status String @default("pending")

  reviewedAt DateTime?
  reviewedBy String?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model SupportTicket {
  id String @id @default(cuid())

  ticketNumber String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String?
  customerPhone String?
  customerEmail String?

  subject String

  category String @default("general")
  priority String @default("normal")
  status   String @default("open")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  messages SupportMessage[]

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model SupportMessage {
  id String @id @default(cuid())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderType String
  senderName String?

  message String

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model CartReminder {
  id String @id @default(cuid())

  cartId String
  cart   ShoppingCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  channel String
  status  String @default("pending")

  recipient String?
  message   String?

  sentAt DateTime?
  error  String?

  createdAt DateTime @default(now())

  @@index([cartId])
  @@index([status])
  @@index([createdAt])
}

model CustomerAccount {
  id               String            @id @default(cuid())
  customerId       String            @unique
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  email            String            @unique
  resetTokenHash   String?           @unique
  resetExpiresAt   DateTime?
  resetRequestedAt DateTime?
  resetWindowAt    DateTime?
  resetRequests    Int               @default(0)
  passwordHash     String
  failedLogins     Int               @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         CustomerSession[]
}

model CustomerSession {
  id        String          @id
  accountId String
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime        @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

model GuestSession {
  id        String   @id
  tokenHash String   @unique
  expiresAt DateTime

  @@index([expiresAt])
}

model StoreSettings {
  id        String   @id @default("main")
  enabled   Boolean  @default(false)
  bankName  String   @default("")
  iban      String   @default("")
  shipping  Float    @default(99)
  threshold Float    @default(2000)
  updatedAt DateTime @updatedAt
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String    @default("")
  discountPercent Float
  minSubtotal     Float     @default(0)
  maxUses         Int?
  usedCount       Int       @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CatalogEntry {
  id        String   @id @default(cuid())
  kind      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, name])
}

model IntegrationSetting {
  slug      String   @id
  enabled   Boolean  @default(false)
  values    Json
  updatedAt DateTime @updatedAt
}

model SiteConfiguration {
  id              String   @id @default("main")
  siteTitle       String   @default("AKN Motosiklet | Yedek Parça ve Aksesuar")
  siteDescription String   @default("Motosiklet yedek parça ve aksesuar mağazası")
  keywords        String   @default("")
  geoContent      String   @default("")
  smtpHost        String   @default("")
  smtpPort        Int      @default(587)
  smtpUser        String   @default("")
  smtpPassword    String   @default("")
  smtpFrom        String   @default("")
  smtpEnabled     Boolean  @default(false)
  publicUrl       String   @default("")
  updatedAt       DateTime @updatedAt
}

model Subscription {
  id             String   @id @default(cuid())
  customerId     String?
  customerName   String
  customerPhone  String
  customerEmail  String?
  status         String   @default("active")
  frequency      String
  intervalCount  Int      @default(1)
  remainingRuns  Int?
  nextRunAt      DateTime
  lastRunAt      DateTime?
  paymentMethod  String   @default("transfer")
  deliveryCity   String
  deliveryDistrict String
  deliveryAddress  String
  invoiceType    String   @default("individual")
  companyName    String?
  taxOffice      String?
  taxNumber      String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          SubscriptionItem[]

  @@index([customerId])
  @@index([status])
  @@index([nextRunAt])
}

model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  productName    String
  sku            String
  unitPrice      Float
  quantity       Int
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
  @@index([productId])
}

model AccountPayment {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount         Float
  status         String   @default("pending")
  provider       String   @default("sipay")
  providerRef    String?
  erpMovementId  String?
  erpSyncedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
}
